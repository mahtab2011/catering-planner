# Copy this file to .env.local (gitignored) for local development, or
# configure these as environment variables in the Hostinger deployment
# environment for production. NEVER commit real values — this file
# documents which variables are required, not what they should be set to.
# See docs/HOSTINGER-DEPLOYMENT.md.

# Firebase client SDK config (all NEXT_PUBLIC_ — safe to expose to the
# browser; these identify the Firebase project, they are not secrets).
# Get these from the Firebase console: Project settings > General >
# Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# London Food Hubs' own production origin (lib/site.ts). Optional —
# defaults to https://londonfoodhubs.com in production and
# http://localhost:3000 in development if unset. Set this explicitly
# for a staging deployment so it doesn't emit production canonical/
# hreflang/sitemap URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=
