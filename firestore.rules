rules_version = '2';

// =============================================================
// London Food Hubs / SmartServeUK — Firestore Security Rules
//
// NOT YET DEPLOYED. This file is version-controlled architecture,
// written and reviewed locally, but has not been applied to the
// live Firebase project (see docs/SECURITY-FOLLOWUP.md for why, and
// the exact manual steps required before it can safely go live).
//
// Authorization model
// --------------------
// Admin authorization is granted ONLY through a Firebase Auth custom
// claim (`request.auth.token.admin == true`), never through the
// `users/{uid}.role` Firestore field. That field is writable by
// end users' own signup flows and must not be trusted for privileged
// actions — see isAdmin() below. Custom claims can only be set by
// the Firebase Admin SDK (a Cloud Function — see functions/index.js
// — or a trusted one-off script), never by a Firestore write, so a
// client can never grant itself admin this way.
//
// Ownership model
// ----------------
// A restaurant document is owned by the user whose uid is stored in
// its `ownerUid` field. Only that user (or an admin) may update it.
// Restaurants with an empty/missing ownerUid ("unclaimed" — mostly
// legacy documents created before this ownership model existed, or
// created by an admin converting a signup without linking it) are
// editable by admins only, not by "whoever edits it first" — that
// insecure claim-on-edit behavior existed in the application code
// before this session and has been removed (see the implementation
// report for the exact migration/backfill this implies for any
// already-live unclaimed restaurants).
//
// SCOPE — read this before deploying anything
// --------------------------------------------
// A full collection inventory now exists —
// docs/FIRESTORE-COLLECTION-INVENTORY.md — covering all 28 Firestore
// collections this app uses. This file reflects that inventory:
//
//   - reviews, articles, recommendations, restaurants,
//     restaurant_signups, users: fully covered (original scope).
//   - restaurant_correction_requests: added for the London Launch
//     claim/correction/removal foundation — see
//     docs/RESTAURANT-CLAIM-WORKFLOW.md. Not one of the original 28;
//     this is a new collection this task introduces.
//   - restaurant_import_candidates: added for the restaurant
//     import-pipeline staging/review foundation — see
//     docs/RESTAURANT-IMPORT-PIPELINE.md. Entirely admin-only, no
//     client create path at all. Not one of the original 28.
//   - restaurant_translation_requests: added for the restaurant
//     content-translation request workflow — see
//     docs/MULTILINGUAL-ARCHITECTURE.md. Owner-only create (status
//     REQUESTED, cross-checked against the restaurant's own
//     ownerUid), admin-only thereafter. Not one of the original 28.
//   - staff, customers, events, sales_signups, blackcab_early_access,
//     blackcab_bookings, blackcab_journey_ratings, blackcab_concerns,
//     blackcab_signups, catering_house_signups, customer_signups,
//     supplier_signups, blackcabs, blackcab_drivers,
//     riderCorrectionLogs (create only): covered, based on a clear,
//     consistent pattern found in application code — see the
//     "CONFIDENTLY COVERABLE" section below.
//   - orders, counters, riders, rider_signups (read scope),
//     suppliers, supplier_items, supplier_orders, catering_houses,
//     ingredients, activity_logs (read): deliberately NOT covered —
//     see the "REQUIRES MANUAL POLICY DECISION" section below and the
//     inventory doc for exactly why each one can't be inferred safely.
//   - Everything else (promotions, and anything not found by this
//     session's audit): not covered, falls through to default deny.
//
// Firestore rules default-deny any path with no matching `match`
// block. That means deploying this file does NOT silently open
// anything uncovered — but it DOES mean every REQUIRES-MANUAL-POLICY-
// DECISION collection becomes fully inaccessible (including to admins)
// the moment these rules go live, until that collection gets its own
// `match` block. For collections where the app currently has NO
// authorization check at all (see the inventory), that's a behavior
// change from "open" to "closed" — likely the right direction
// security-wise, but confirm it won't break an operational workflow
// (e.g. an unauthenticated kitchen-display screen) before deploying.
// =============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Custom claim only. Do NOT fall back to reading users/{uid}.role
      // here — that field is user-writable and would let any signed-in
      // user grant themselves admin by editing their own profile doc.
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwnUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchanged(field) {
      // True if `field` is not present in the incoming document, or is
      // present but equal to its current value — i.e. this write does
      // not modify it. Used to protect specific fields (ratings,
      // moderation status, ownership) from being smuggled into an
      // otherwise-legitimate update.
      return !(field in request.resource.data) ||
        request.resource.data[field] == resource.data.get(field, null);
    }

    // ---------- reviews ----------
    // Public marketplace reviews. Written by customers as "pending";
    // only an admin may move them to "approved"/"rejected". Public
    // reads only ever see approved reviews.

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantId.size() > 0
        && request.resource.data.displayName is string
        && request.resource.data.reviewText is string
        && request.resource.data.reviewText.size() > 0
        && request.resource.data.reviewText.size() <= 2000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && (!('title' in request.resource.data) || request.resource.data.title is string)
        && !('moderatedBy' in request.resource.data)
        && !('moderatedAt' in request.resource.data)
        && !('moderationNote' in request.resource.data);

      // Admins may moderate (status/moderation fields only). The
      // author may edit their own review's content, but only while it
      // is still pending, and may never touch the moderation fields or
      // re-approve/re-reject themselves.
      allow update: if (
          isAdmin()
          && unchanged('userId')
          && unchanged('restaurantId')
          && unchanged('rating')
          && unchanged('reviewText')
          && unchanged('displayName')
        ) || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && unchanged('userId')
          && unchanged('restaurantId')
          && unchanged('moderatedBy')
          && unchanged('moderatedAt')
          && unchanged('moderationNote')
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.reviewText is string
          && request.resource.data.reviewText.size() > 0
          && request.resource.data.reviewText.size() <= 2000
        );

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- articles (blog) ----------
    // Editorial content. Public may only ever query/read published
    // articles; drafts are admin-only, enforced here (not just by the
    // app only querying for status == "published").

    match /articles/{articleId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- recommendations ----------
    // "London Food Hubs Recommends" editorial picks — distinct from
    // customer reviews. Public may only read active recommendations.

    match /recommendations/{recommendationId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- restaurants ----------
    // Public listings + owner-managed profile/menu data. Menu items
    // live inline on the restaurant document (`menuCategories`), so
    // there is no separate menu-item collection to protect — the
    // owner-update branch below covers menu edits too.
    //
    // `rating` / `reviewCount` are a trusted aggregate maintained only
    // by the Cloud Function in functions/index.js (which uses the
    // Admin SDK and is not subject to these rules at all) — client
    // writes, including the owner's own, may never change them.

    match /restaurants/{restaurantId} {
      allow read: if resource.data.status in ['active', 'pending']
        || isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          // citySlug is required from creation — see lib/cities.ts —
          // so every restaurant is unambiguously scoped to one city
          // edition from day one, not backfilled later.
          && request.resource.data.citySlug is string
          && request.resource.data.citySlug.size() > 0
          && request.resource.data.get('rating', 0) == 0
          && request.resource.data.get('reviewCount', 0) == 0
          && request.resource.data.get('isFeatured', false) == false
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.ownerUid != ''
          && unchanged('ownerUid')
          // A business can't move itself to a different city edition
          // — that's a structural/administrative fact, not editable
          // profile content, same reasoning as ownerUid above.
          && unchanged('citySlug')
          && unchanged('rating')
          && unchanged('reviewCount')
          && unchanged('isFeatured')
          && unchanged('isApproved')
          && resource.data.status != 'blocked'
          && request.resource.data.status != 'blocked'
        )
        || (
          // Ownership CLAIM SUBMISSION — see
          // docs/RESTAURANT-CLAIM-WORKFLOW.md. Any signed-in user may
          // claim a currently-unclaimed restaurant (e.g. an
          // admin-imported record with no owner yet) by writing ONLY
          // `claimantUid` (to themselves) and `ownerClaimStatus` (to
          // 'claim_pending'), plus `claimSubmittedAt`/`updatedAt`.
          // This can NEVER set `ownerUid` — that stays unchanged here,
          // exactly like the owner-update branch above. Only an admin
          // (the isAdmin() branch, unrestricted) may later promote a
          // claim to actual ownership by setting ownerUid — no
          // client-writable path exists from claimantUid to ownerUid.
          // This intentionally repeats the fix for the earlier
          // claim-on-edit vulnerability: submitting a claim is NEVER
          // itself an edit right, and can't be smuggled into one by
          // also changing other fields — the diff below is restricted
          // to exactly the claim fields.
          isSignedIn()
          && resource.data.get('ownerUid', '') == ''
          && resource.data.get('ownerClaimStatus', 'unclaimed') in ['unclaimed', 'claim_rejected']
          && request.resource.data.claimantUid == request.auth.uid
          && request.resource.data.ownerClaimStatus == 'claim_pending'
          // Contact/evidence fields — see docs/RESTAURANT-CLAIM-WORKFLOW.md's
          // "Claimant contact information" section (Task F). Name and
          // business email are the two things an admin actually needs to
          // reach a real claimant, so they're required; the rest (role,
          // phone, a free-text note) are optional context, not identity
          // verification.
          && request.resource.data.claimantName is string
          && request.resource.data.claimantName.size() > 0
          && request.resource.data.claimantContactEmail is string
          && request.resource.data.claimantContactEmail.size() > 0
          && (!('claimantRole' in request.resource.data) || request.resource.data.claimantRole is string)
          && (!('claimantContactPhone' in request.resource.data) || request.resource.data.claimantContactPhone is string)
          && (!('claimantNote' in request.resource.data) || request.resource.data.claimantNote is string)
          && unchanged('ownerUid')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'claimantUid', 'ownerClaimStatus', 'claimSubmittedAt', 'updatedAt',
                 'claimantName', 'claimantRole', 'claimantContactEmail',
                 'claimantContactPhone', 'claimantNote'
               ])
        );

      allow delete: if isAdmin();
    }

    // ---------- restaurant_correction_requests ----------
    // Moderation-queue requests from a member of the public asking for
    // a restaurant's details to be corrected, or the listing removed.
    // Never applied automatically — an admin reviews and, if accepted,
    // makes the actual edit to the restaurant document themselves (via
    // the isAdmin() branch on /restaurants/{restaurantId} above). See
    // docs/RESTAURANT-CLAIM-WORKFLOW.md.

    match /restaurant_correction_requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.submittedByUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantId.size() > 0
        && request.resource.data.requestType in ['correction', 'removal']
        && request.resource.data.status == 'pending'
        && !('moderatedBy' in request.resource.data)
        && !('moderatedAt' in request.resource.data)
        && !('moderationNote' in request.resource.data);

      // Only an admin may moderate — no requester-driven or anonymous
      // direct edits to a submitted request's outcome.
      allow update: if isAdmin()
        && unchanged('restaurantId')
        && unchanged('submittedByUid')
        && unchanged('requestType');

      allow delete: if isAdmin();
    }

    // ---------- restaurant_import_candidates ----------
    // Staging/review queue for the restaurant import pipeline — see
    // docs/RESTAURANT-IMPORT-PIPELINE.md. Entirely internal: no
    // client, including a signed-in non-admin user, may read, create,
    // update, or delete anything here. Candidates are created ONLY by
    // functions/scripts/stageImportCandidates.js via the Admin SDK
    // (which bypasses these rules entirely, the same trust model as
    // functions/scripts/bootstrapFirstAdmin.js) — never by a client
    // Firestore write, not even an admin's. That keeps "what's in the
    // staging queue" fully auditable to whoever ran the staging
    // script, with no path for a candidate to appear any other way.
    // Admins review and change status (PENDING_REVIEW -> APPROVED /
    // REJECTED / DUPLICATE / NEEDS_RESEARCH) through the app; only
    // functions/scripts/applyApprovedImportBatch.js (again, Admin
    // SDK) ever promotes an APPROVED candidate into a real
    // restaurants/{id} document, and only for an explicit,
    // human-produced approved-batch file — never automatically.

    match /restaurant_import_candidates/{candidateId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ---------- restaurant_translation_requests ----------
    // Data architecture for OPTIONAL, PAID, restaurant-approved
    // translations of a restaurant's own content — see
    // docs/MULTILINGUAL-ARCHITECTURE.md's "Restaurant-supplied
    // content" policy. NO pricing or payment processing is
    // implemented anywhere in this codebase; this collection is the
    // request/workflow record only.
    //
    // Only the ACTUAL owner of the target restaurant may create a
    // request (cross-checked against restaurants/{restaurantId}.ownerUid
    // via get(), not just self-asserted), and only in status
    // 'REQUESTED' — a client can never set any other status, and can
    // never set quotedAmount/quotedCurrency/paymentReceivedAt at
    // create time (pricing is an admin/ops-only, plain-stored-value
    // decision made afterwards, never client-supplied or computed).
    // Every later transition (QUOTED, PAYMENT_PENDING, IN_TRANSLATION,
    // OWNER_REVIEW, PUBLISHED, CANCELLED) is admin-only through this
    // collection. Reaching PUBLISHED here does NOT itself write
    // RestaurantDoc.contentTranslations — that still requires a
    // separate, deliberate admin write to the restaurant document
    // (via the existing isAdmin() branch on /restaurants/{id}), so a
    // translation can never appear live without a human explicitly
    // publishing it there too.

    match /restaurant_translation_requests/{requestId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantId.size() > 0
        && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.ownerUid == request.auth.uid
        && !('quotedAmount' in request.resource.data)
        && !('quotedCurrency' in request.resource.data)
        && !('paymentReceivedAt' in request.resource.data)
        && !('publishedAt' in request.resource.data);

      // Only an admin may progress the workflow from here.
      allow update: if isAdmin()
        && unchanged('restaurantId')
        && unchanged('requestedByUid');

      allow delete: if isAdmin();
    }

    // ---------- restaurant_signups ----------
    // One application document per applicant, document id == the
    // applicant's own uid (see app/signup/restaurant/page.tsx). The
    // applicant may create their own application as status "new" only
    // — they can never write themselves straight to "approved". Only
    // an admin may change status afterwards (matches the app: the
    // signup form never updates this collection post-creation, only
    // the admin review pages do).

    match /restaurant_signups/{uid} {
      allow read: if isAdmin() || isOwnUid(uid);

      allow create: if isOwnUid(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'new';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- users ----------
    // Account/role record. A user may read and update their own
    // document, but can never change their own `role` — that is the
    // one field that must only ever move under admin control, since
    // `canAccess()` in the app (advisory UI gating) and, more
    // importantly, any rule elsewhere that still needs to consult it
    // both depend on it being trustworthy at the data layer.

    match /users/{uid} {
      allow read: if isAdmin() || isOwnUid(uid);

      allow create: if isOwnUid(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role != 'admin';

      allow update: if isAdmin()
        || (isOwnUid(uid) && unchanged('role'));

      allow delete: if isAdmin();
    }

    // =========================================================
    // CONFIDENTLY COVERABLE — existing SmartServeUK collections
    // where a clear, consistent authorization pattern was found in
    // application code (see docs/FIRESTORE-COLLECTION-INVENTORY.md
    // for the full file-by-file trace behind each one). Still NOT
    // deployed — see the file-level note at the top.
    // =========================================================

    // ---------- staff ----------
    // Every access point in app/staff/* scopes by ownerUid; no page
    // reads/writes the full collection unfiltered.
    match /staff/{staffId} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
    }

    // ---------- customers ----------
    // Every access point in app/customers/* and EventForm scopes by
    // bossUid, consistently.
    match /customers/{customerId} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.bossUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.bossUid == request.auth.uid);
    }

    // ---------- events ----------
    // Every access point scopes by bossUid (app/dashboard and
    // app/dashboard.old skip the canAccess(["catering_house"]) role
    // check but still filter by bossUid in their query, so data
    // isolation holds regardless of that separate, lower-severity
    // feature-appropriateness gap).
    match /events/{eventId} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.bossUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.bossUid == request.auth.uid);
    }

    // ---------- sales_signups ----------
    // Public lead form (app/sales-signup) by design; admin-only read,
    // matching app/admin/page.tsx's existing useAdminGate() UI.
    match /sales_signups/{signupId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------- blackcab_early_access / bookings / journey_ratings / concerns ----------
    // Public create by design (app/blackcab/BlackCabContent.tsx has no
    // gate anywhere, intentionally — these are public lead/booking/
    // feedback forms). Read restricted to admin: app/admin/
    // blackcab-leads/page.tsx has NO authorization check in its own
    // code (a real gap, matching every sibling admin page except this
    // one) but was not modified here per this session's standing
    // instruction not to alter BlackCab application code — this rule
    // still closes the PII exposure at the data layer regardless of
    // whether that app-code gate is ever added.
    match /blackcab_early_access/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /blackcab_bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /blackcab_journey_ratings/{ratingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /blackcab_concerns/{concernId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---------- *_signups staging collections ----------
    // Same shape as restaurant_signups above: create-as-self only,
    // status forced to a non-approved starting value is NOT enforced
    // here (unlike restaurant_signups) because no consumer of these
    // four collections was found anywhere in the app — there is no
    // admin review UI reading blackcab_signups, catering_house_signups,
    // customer_signups, or supplier_signups, so there is no
    // self-approval path to close yet. If a review UI is built later,
    // add the same status == 'new' (or equivalent) constraint used on
    // restaurant_signups' create rule at that time.
    match /blackcab_signups/{uid} {
      allow read: if isAdmin() || isOwnUid(uid);
      allow create: if isOwnUid(uid);
      allow update, delete: if isAdmin();
    }
    match /catering_house_signups/{uid} {
      allow read: if isAdmin() || isOwnUid(uid);
      allow create: if isOwnUid(uid);
      allow update, delete: if isAdmin();
    }
    match /customer_signups/{uid} {
      allow read: if isAdmin() || isOwnUid(uid);
      allow create: if isOwnUid(uid);
      allow update, delete: if isAdmin();
    }
    match /supplier_signups/{uid} {
      allow read: if isAdmin() || isOwnUid(uid);
      allow create: if isOwnUid(uid);
      allow update, delete: if isAdmin();
    }

    // ---------- blackcabs / blackcab_drivers ----------
    // Only ever touched via lib/auth.ts (registerUser/changePassword,
    // both scoped to the caller's own uid) and a legacy own-uid lookup
    // in app/login — no page anywhere manages another user's document
    // in either collection.
    match /blackcabs/{uid} {
      allow read, write: if isAdmin() || isOwnUid(uid);
    }
    match /blackcab_drivers/{uid} {
      allow read, write: if isAdmin() || isOwnUid(uid);
    }

    // ---------- riderCorrectionLogs (write side only) ----------
    // app/orders/riders/page.tsx always writes an ownerUid field under
    // a canAccess(["restaurant","staff"]) gate — that much is
    // consistent and safe to formalize. Read access is NOT covered
    // here: app/orders/rider-corrections/page.tsx reads the entire
    // collection with no filter and no authorization check at all —
    // see docs/FIRESTORE-COLLECTION-INVENTORY.md's REQUIRES MANUAL
    // POLICY DECISION section. Leaving read ungranted here means it
    // stays default-denied (safe) until that's decided; it does NOT
    // mean the existing app page will keep working unauthenticated.
    match /riderCorrectionLogs/{logId} {
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow read, update, delete: if isAdmin();
    }

    // =========================================================
    // REQUIRES MANUAL POLICY DECISION — deliberately NOT covered
    //
    // orders, counters, riders, rider_signups (read scope only),
    // suppliers, supplier_items, supplier_orders, catering_houses,
    // ingredients, activity_logs (read only).
    //
    // Every one of these has at least one access point in the
    // application with NO authorization check at all (full collection
    // read/write, no login required), which is either a real bug or an
    // intentional design this repository's code doesn't explain either
    // way. Writing a permissive rule to match that behavior would be
    // exactly the kind of guess this work was asked not to make;
    // writing a restrictive rule to match a *different* page's
    // ownerUid-scoped pattern would silently break the unscoped page
    // the moment these rules deploy. Both are unsafe without a human
    // decision first. See docs/FIRESTORE-COLLECTION-INVENTORY.md for
    // the exact question that needs answering for each one, and the
    // application-code changes some of them need BEFORE a rule can be
    // added at all (supplier_orders has no owner field to scope by;
    // kitchen/ready/search/delivery order pages have no query filter
    // to match a scoped rule against).
    //
    // Everything else not listed anywhere in this file (promotions,
    // and any collection not found by this session's audit) is also
    // untouched and falls through to Firestore's default deny.
    // =========================================================
  }
}
